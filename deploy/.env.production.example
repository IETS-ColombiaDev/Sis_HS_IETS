# ============================================================================
#  Sistema de Escaneo de Horizonte - IETS   |   Variables de PRODUCCION
# ============================================================================
# 1. Copie este archivo como deploy/.env.production (ignorado por git).
# 2. Complete como minimo: SECRET_KEY, POSTGRES_PASSWORD, CORS_ORIGINS,
#    SITE_DOMAIN (si usa el perfil https) y GOOGLE_CLIENT_ID.
# 3. Use SIEMPRE:  docker compose --env-file deploy/.env.production ...
#    (el mismo archivo alimenta la interpolacion de docker-compose.yml y las
#    variables de los contenedores api y worker).
#
# Contiene TODAS las variables de backend/.env.example con valores seguros por
# defecto para produccion, mas las propias del despliegue con contenedores.
# Nunca publique este archivo con valores reales. Ver DEPLOY.md.
# ============================================================================

# --- Entorno (P0-3) ----------------------------------------------------------
# production apaga el acceso de desarrollo sin importar ALLOW_DEV_LOGIN y el
# arranque se niega a continuar sin una SECRET_KEY propia de >= 32 caracteres.
ENVIRONMENT=production

# --- Seguridad de sesiones (JWT) ---------------------------------------------
# OBLIGATORIA. Con ENVIRONMENT=production el arranque FALLA si queda vacia, si
# es la de ejemplo o si tiene menos de 32 caracteres. Genere una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Cambiarla cierra todas las sesiones abiertas (ver DEPLOY.md, rotacion).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Acceso con correo y contrasena ------------------------------------------
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Autenticacion con Google (cuentas @iets.org.co) -------------------------
# Client ID OAuth 2.0 (tipo "Aplicacion web"). En Google Cloud Console agregue
# https://SITE_DOMAIN a "Origenes autorizados de JavaScript".
GOOGLE_CLIENT_ID=
ALLOWED_EMAIL_DOMAIN=iets.org.co

# Correos que reciben el perfil de superadministrador al iniciar sesion.
# Recomendado en produccion: dejar vacio y crear el primer superadministrador
# con  python -m app.cli create-admin  (ver DEPLOY.md).
ADMIN_EMAILS=

# Acceso de demostracion sin contrasena. SIEMPRE false en produccion (ademas
# ENVIRONMENT=production lo ignora); el intento queda en la bitacora.
ALLOW_DEV_LOGIN=false

# --- MiniMax (IA principal) --------------------------------------------------
MINIMAX_API_KEY=
MINIMAX_MODEL=
# auto | minimax | gemini
AI_PROVIDER=auto
AI_WEB_ENABLED=true
AI_OCR_ENABLED=false

# --- Gemini (respaldo opcional) ----------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=

# --- General -----------------------------------------------------------------
# Solo el origen publico real (https). Separados por coma.
CORS_ORIGINS=https://horizonte.iets.org.co

# Vacio = docker-compose.yml la arma con POSTGRES_USER/PASSWORD/DB contra el
# servicio db. Definala solo para usar un PostgreSQL externo, con el driver
# psycopg 3:  postgresql+psycopg://usuario:clave@host:5432/base
DATABASE_URL=

# Siembra de los ciclos oficiales 2026 de demostracion. En produccion va apagada
# por defecto: los ciclos los crea y gobierna la coordinacion.
SEED_OFFICIAL_CYCLES=false

# --- Fase 4: ingesta asincrona y portal publico ------------------------------
# docker-compose.yml fuerza este valor por servicio: false en api (varios
# procesos) y true en worker (un proceso). Aqui solo documenta el defecto.
INGEST_WORKER_ENABLED=false
INGEST_WORKER_INTERVAL_SECONDS=20

# reCAPTCHA v3 del portal publico /postular. En produccion configurelo (P2-3):
# vacio = el portal omite la verificacion anti-robot.
RECAPTCHA_SECRET=
RECAPTCHA_SITE_KEY=
# Puntaje minimo de reCAPTCHA (0 = robot, 1 = humano) y tope de postulaciones
# por IP en la ventana indicada (segundos).
RECAPTCHA_MIN_SCORE=0.5
PUBLIC_SUBMISSIONS_PER_WINDOW=5
PUBLIC_SUBMISSIONS_WINDOW_SECONDS=600

# --- Correo (P3-2 invitacion al revisor externo, P4-2 alertas) ----------------
# Sin SMTP_HOST el envio es un no-op y la interfaz ofrece copiar el enlace.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# URL publica para los enlaces absolutos de los correos (sin barra final).
PUBLIC_BASE_URL=https://horizonte.iets.org.co

# --- Fuentes de nivel A (catalogo D-06) --------------------------------------
OPENFDA_API_KEY=
NCBI_API_KEY=
NCBI_EMAIL=escaneo.horizonte@iets.org.co

# --- Directorio RRHH (Firestore) ---------------------------------------------
FIREBASE_PROJECT_ID=sistema-permisos-iets
# JSON de la cuenta de servicio en una sola linea, o bien la ruta a un archivo
# montado en el contenedor (ver el volumen comentado en docker-compose.yml),
# p. ej. /run/secrets/firebase-sa.json
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_RRHH_ENV_FILE=

# ============================================================================
#  Solo despliegue con contenedores (docker-compose.yml)
# ============================================================================
# PostgreSQL 15 del servicio db. Use una clave solo con caracteres seguros en
# URL (letras, digitos, - y _), p. ej.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB=iets_horizonte
POSTGRES_USER=iets
POSTGRES_PASSWORD=

# Procesos de uvicorn del servicio api (regla practica: 2 x nucleos, maximo 4-8).
WEB_CONCURRENCY=2

# Puerto publicado de la API en el servidor. Por defecto solo en 127.0.0.1:
# el acceso externo pasa por el proxy HTTPS (Caddy o el institucional).
API_BIND=127.0.0.1
API_PORT=8000

# Etiqueta de la imagen construida (para revertir, vuelva a la anterior).
IMAGE_TAG=latest

# Perfil "https" (Caddy con certificados automaticos).
SITE_DOMAIN=horizonte.iets.org.co
ACME_EMAIL=
