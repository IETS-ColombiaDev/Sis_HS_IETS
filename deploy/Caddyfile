# ============================================================================
#  Proxy HTTPS de ejemplo (Caddy 2) - perfil "https" de docker-compose.yml
# ============================================================================
# Caddy obtiene y renueva solo el certificado (Let's Encrypt / ZeroSSL) para
# SITE_DOMAIN. Requisitos: el DNS de SITE_DOMAIN apunta a este servidor y los
# puertos 80 y 443 estan abiertos desde internet (el reto ACME usa el 80).
# Si la institucion ya tiene un proxy o balanceador con TLS, no use este perfil:
# apunte ese proxy a 127.0.0.1:8000 (ver DEPLOY.md, "HTTPS").
#
#   docker compose --env-file deploy/.env.production --profile https up -d
#
# Para recibir avisos de vencimiento del certificado, agregue al inicio un
# bloque global:   { email {$ACME_EMAIL} }
# ============================================================================

{$SITE_DOMAIN:localhost} {
	encode zstd gzip

	# Fase 7 del plan: TLS moderno. Caddy negocia TLS 1.3 y acepta 1.2 como
	# minimo; para exigir solo 1.3 descomente:
	# tls {
	# 	protocols tls1.3
	# }

	# Los encabezados de seguridad (CSP, HSTS en produccion, X-Frame-Options,
	# nosniff, Referrer-Policy, Permissions-Policy) los emite la propia
	# aplicacion (main.py). No se repiten aqui: duplicarlos, sobre todo la CSP,
	# produce dos politicas que el navegador combina de forma restrictiva.
	header -Server

	# La carga plana del indice de INVIMA (POST /api/invima/sync/file) puede ser grande.
	request_body {
		max_size 200MB
	}

	# Caddy agrega X-Forwarded-For y X-Forwarded-Proto; uvicorn los acepta porque
	# el servicio api tiene FORWARDED_ALLOW_IPS="*" y solo es alcanzable por la
	# red interna de compose y por 127.0.0.1 del servidor.
	reverse_proxy api:8000
}
