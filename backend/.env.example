# ============================================================================
#  Sistema de Escaneo de Horizonte - IETS   |   Variables de entorno
# ============================================================================
# Copie este archivo como  .env  y complete los valores.

# --- Entorno -----------------------------------------------------------------
# development | testing | production. En production:
#   - el acceso sin contrasena (ALLOW_DEV_LOGIN) queda apagado siempre;
#   - el servidor NO arranca si SECRET_KEY es la de ejemplo o tiene < 32 caracteres;
#   - se envia Strict-Transport-Security (sirva la aplicacion detras de HTTPS).
# Verifique con:  python -m app.cli check-config
ENVIRONMENT=development

# --- Seguridad de sesiones (JWT) ---------------------------------------------
# En produccion genere una propia:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Cambiarla cierra todas las sesiones abiertas.
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Acceso con correo y contrasena ------------------------------------------
# Las cuentas las crea el superadministrador en /usuarios (o con
#   python -m app.cli create-admin --email persona@iets.org.co --name "Nombre"
# para la primera). Las contrasenas temporales se cambian en el primer ingreso.
PASSWORD_MIN_LENGTH=10
# Intentos fallidos antes de bloquear la cuenta y minutos de bloqueo.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Autenticacion con Google (cuentas @iets.org.co) -------------------------
# Opcional. Cree credenciales OAuth 2.0 (tipo "Aplicacion web") en Google Cloud
# Console y pegue aqui el Client ID. Vacio = el boton de Google no se muestra.
GOOGLE_CLIENT_ID=

# Dominio institucional permitido para iniciar sesion.
ALLOWED_EMAIL_DOMAIN=iets.org.co

# Correos que seran administradores la primera vez que inicien sesion
# (separados por coma). Ej: admin@iets.org.co,coord@iets.org.co
ADMIN_EMAILS=admin@iets.org.co

# Acceso sin contrasena para desarrollo local. Se ignora con ENVIRONMENT=production.
ALLOW_DEV_LOGIN=true

# --- MiniMax (IA principal) --------------------------------------------------
# Llave internacional (api.minimax.io). Vacio = deteccion automatica del modelo.
MINIMAX_API_KEY=
MINIMAX_MODEL=
# auto | minimax | gemini
AI_PROVIDER=auto
# La IA entra a los sitios y estructura senales. OCR lee imagenes/PDF escaneados.
AI_WEB_ENABLED=true
AI_OCR_ENABLED=false

# --- Gemini (respaldo opcional) ----------------------------------------------
# Cree una API key en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Dejar vacio para deteccion automatica del mejor modelo disponible.
GEMINI_MODEL=

# --- General -----------------------------------------------------------------
# Origenes permitidos para CORS (frontend). Separados por coma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000,http://localhost:8000
DATABASE_URL=sqlite:///./iets_horizonte.db
# Siembra de los ciclos oficiales 2026 al arrancar: por defecto activa en
# desarrollo y apagada con ENVIRONMENT=production. true/false la fuerza.
# SEED_OFFICIAL_CYCLES=true

# --- Fase 4: ingesta asincrona y portal publico ------------------------------
# El worker recorre ingest_jobs en un hilo del proceso. Poner false en pruebas
# unitarias si no se quiere que dispare conectores de fondo.
INGEST_WORKER_ENABLED=true
INGEST_WORKER_INTERVAL_SECONDS=20

# reCAPTCHA v3 del portal /postular. Solo opera con AMBAS llaves; con una sola o
# ninguna, el formulario declara "modo degradado" (tope por IP y campo trampa).
# La vigilancia programada y el barrido de duplicados se configuran en
# /configuracion > Tareas programadas (se guardan en la base, no aqui).
RECAPTCHA_SECRET=
RECAPTCHA_SITE_KEY=
# Puntaje minimo de reCAPTCHA v3 (0 = robot, 1 = humano) y tope de envios por IP.
RECAPTCHA_MIN_SCORE=0.5
PUBLIC_SUBMISSIONS_PER_WINDOW=5
PUBLIC_SUBMISSIONS_WINDOW_SECONDS=600

# --- Fuentes de nivel A (catalogo D-06) --------------------------------------
# Llave gratuita de api.data.gov / openFDA. Sin ella el cupo diario es bajo.
OPENFDA_API_KEY=
# Llave y correo institucional de NCBI para PubMed E-utilities.
NCBI_API_KEY=
NCBI_EMAIL=escaneo.horizonte@iets.org.co

# --- Directorio RRHH (Firestore). Si el correo coincide, se usan nombres y apellidos
# institucionales. No se muestra el nombre residual de la base local.
FIREBASE_PROJECT_ID=sistema-permisos-iets
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_SERVICE_ACCOUNT_FILE=

# --- Canal de correo (P3-2 invitacion al revisor externo, P4-2 alertas) -------
# Sin SMTP_HOST el envio es un no-op: la invitacion muestra el enlace para
# copiarlo y las alertas quedan solo en la bandeja /alertas.
# Puerto 587 con SMTP_TLS=true (STARTTLS) o 465 (SSL directo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=escaneo.horizonte@iets.org.co
SMTP_TLS=true
# URL publica con la que se arman los enlaces absolutos de los correos
# (ej. https://horizonte.iets.org.co). Vacio = se usa la URL de la peticion.
PUBLIC_BASE_URL=
